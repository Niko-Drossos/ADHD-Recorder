# --- database ---
POSTGRES_USER=recall
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=recall
POSTGRES_URL=127.0.0.1

# --- auth ---
# Generate with:  openssl rand -hex 32
INGEST_TOKEN=change-me

# --- bind address ---
# Set to this host's Tailscale IP so the API is only reachable on the tailnet.
# e.g. BIND_ADDR=100.x.y.z    (127.0.0.1 = local only)
BIND_ADDR=127.0.0.1
PORT=8000

# --- whisper ---
# tiny | base | small | medium | large-v3
# small = good accuracy, ~5x realtime on a modern CPU. Start here.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# int8 for CPU, float16 for GPU
WHISPER_COMPUTE_TYPE=int8
# Set blank to auto-detect language
WHISPER_LANGUAGE=en

# --- ollama ---
OLLAMA_URL=http://192.168.1.110:11434
OLLAMA_MODEL=llama3.1:8b

# --- retention ---
# Audio files are deleted after this many days. Transcripts are kept indefinitely.
KEEP_AUDIO_DAYS=3
